  },
  "dependencies": {
    "@DCRM/db": "workspace:*",
    "@DCRM/domain": "workspace:*",
    "bullmq": "^5.77.6",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@DCRM/config": "workspace:*",
    "typescript": "catalog:"
  }
}
