# ============================================================
# DCRM Environment Variables
# Copy this file to .env and fill in values before deploying.
# ============================================================

# ---- Required ----

# PostgreSQL connection string
DATABASE_URL=postgresql://dcrm:dcrm@postgres:5432/dcrm

# Better Auth secret (min 32 chars, generate: openssl rand -base64 48)
BETTER_AUTH_SECRET=

# Public-facing base URL of the app (used for auth redirects)
BETTER_AUTH_URL=http://localhost:3001

# CORS allowed origin
CORS_ORIGIN=http://localhost:3001

# Redis URL (BullMQ background jobs)
REDIS_URL=redis://redis:6379

# Encryption master key for the crypto module (min 32 chars)
# generate: openssl rand -hex 16
ENCRYPTION_KEY=

# Application URL (webhook base, general public URL)
APP_URL=http://localhost:3001

# Node environment
NODE_ENV=production

# ---- PostgreSQL (compose internal) ----
POSTGRES_DB=dcrm
POSTGRES_USER=dcrm
POSTGRES_PASSWORD=

# ---- App port override ----
APP_PORT=3001

# ---- Storage (optional, defaults to local) ----
# STORAGE_TYPE=local
# STORAGE_TYPE=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# ---- Stripe billing (optional, env-gated) ----
# BILLING_ENABLED=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# ---- Webhook base URL override (optional, falls back to APP_URL) ----
# WEBHOOK_BASE_URL=
